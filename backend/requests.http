# Pruebas manuales de la API de CondoFlow (IntelliJ HTTP Client).
# Arrancar el backend y ejecutar cada petición con el botón ▶.

### Health (Capítulo 03)
GET http://localhost:8080/api/health
Accept: application/json

### Demo entidad padre (Capítulo 03)
GET http://localhost:8080/api/personas/demo
Accept: application/json

##############################################################
# PERSONAS
##############################################################

### Crear persona válida -> 201
POST http://localhost:8080/api/personas
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Suarez",
  "documento": "9988776",
  "telefono": "+591 71112233",
  "correoElectronico": "ana.suarez@condoflow.com"
}

### Crear persona con campos inválidos -> 400 (fieldErrors)
POST http://localhost:8080/api/personas
Content-Type: application/json

{
  "nombre": "",
  "apellido": "Suarez",
  "documento": "9988776",
  "telefono": "+591 71112233",
  "correoElectronico": "no-es-un-correo"
}

### Crear persona con correo repetido -> 409
POST http://localhost:8080/api/personas
Content-Type: application/json

{
  "nombre": "Maria",
  "apellido": "Otra",
  "documento": "1112223",
  "telefono": "+591 70000009",
  "correoElectronico": "maria.lopez@condoflow.com"
}

### Listar personas -> 200
GET http://localhost:8080/api/personas

### Listar con filtro -> 200
GET http://localhost:8080/api/personas?filtro=lopez

### Buscar persona existente -> 200
GET http://localhost:8080/api/personas/1

### Buscar persona inexistente -> 404
GET http://localhost:8080/api/personas/999

### Actualizar persona (PUT, representación completa) -> 200 (Guía 06 del frontend)
PUT http://localhost:8080/api/personas/2
Content-Type: application/json

{
  "nombre": "Carlos",
  "apellido": "Rojas",
  "documento": "6231457",
  "telefono": "+591 70000002",
  "correoElectronico": "carlos.rojas@condoflow.com",
  "estado": "ACTIVO"
}

### Actualizar con el correo de otra persona -> 409
PUT http://localhost:8080/api/personas/2
Content-Type: application/json

{
  "nombre": "Carlos",
  "apellido": "Rojas",
  "documento": "6231457",
  "telefono": "+591 70000002",
  "correoElectronico": "maria.lopez@condoflow.com",
  "estado": "ACTIVO"
}

### Eliminar persona con residencias -> 409 (usar PUT con estado INACTIVO: baja lógica)
DELETE http://localhost:8080/api/personas/1

### Eliminar persona inexistente -> 404
DELETE http://localhost:8080/api/personas/999

##############################################################
# UNIDADES
##############################################################

### Listar unidades -> 200
GET http://localhost:8080/api/unidades

### Buscar unidad inexistente -> 404
GET http://localhost:8080/api/unidades/999

##############################################################
# RESIDENCIAS
##############################################################

### Registrar residencia -> 201
POST http://localhost:8080/api/residencias
Content-Type: application/json

{
  "personaId": 2,
  "unidadId": 1,
  "tipoResidencia": "INQUILINO",
  "fechaInicio": "2026-09-10"
}

### Registrar la misma residencia vigente otra vez -> 409
POST http://localhost:8080/api/residencias
Content-Type: application/json

{
  "personaId": 2,
  "unidadId": 1,
  "tipoResidencia": "INQUILINO",
  "fechaInicio": "2026-09-10"
}

### Registrar con persona inexistente -> 404
POST http://localhost:8080/api/residencias
Content-Type: application/json

{
  "personaId": 999,
  "unidadId": 1,
  "tipoResidencia": "INQUILINO",
  "fechaInicio": "2026-09-01"
}

### Registrar con tipo fuera del enum -> 400
POST http://localhost:8080/api/residencias
Content-Type: application/json

{
  "personaId": 1,
  "unidadId": 2,
  "tipoResidencia": "ALQUILER",
  "fechaInicio": "2026-09-01"
}

### Registrar sin campos obligatorios -> 400 (fieldErrors)
POST http://localhost:8080/api/residencias
Content-Type: application/json

{
  "unidadId": 1
}

### Listar todas las residencias -> 200 (Guía 05 del frontend)
GET http://localhost:8080/api/residencias

### CORS: el origen de Vite recibe Access-Control-Allow-Origin
GET http://localhost:8080/api/residencias
Origin: http://localhost:5173

### Consultar residencia -> 200
GET http://localhost:8080/api/residencias/1

### Consultar residencia inexistente -> 404
GET http://localhost:8080/api/residencias/999

### Residencias de una persona -> 200
GET http://localhost:8080/api/residencias/persona/2

### Residencias de una persona inexistente -> 404
GET http://localhost:8080/api/residencias/persona/999
